---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Diferenciais from "../components/Diferenciais.astro";
import ComoFunciona from "../components/ComoFunciona.astro";
import Idiomas from "../components/Idiomas.astro";
import Planos from "../components/Planos.astro";
import AulaExperimental from "../components/AulaExperimental.astro";
import Depoimentos from "../components/Depoimentos.astro";
import Professoras from "../components/Professoras.astro";
import NossaHistoria from "../components/NossaHistoria.astro";
import Faq from "../components/Faq.astro";
import Formulario from "../components/Formulario.astro";
import Rodape from "../components/Rodape.astro";
---

<Base>
  <Header />
  <main id="conteudo">
    <Hero />
    <Diferenciais />
    <ComoFunciona />
    <Idiomas />
    <Planos />
    <AulaExperimental />
    <Professoras />
    <Depoimentos />
    <NossaHistoria />
    <Faq />
    <Formulario />
  </main>
  <Rodape />
</Base>
