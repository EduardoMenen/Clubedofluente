---
import Logo from "./Logo.astro";

const navegacao = [
  { rotulo: "Diferenciais", href: "#diferenciais" },
  { rotulo: "Como funciona", href: "#como-funciona" },
  { rotulo: "Idiomas", href: "#idiomas" },
  { rotulo: "Planos", href: "#planos" },
  { rotulo: "Professoras", href: "#professoras" },
  { rotulo: "Dúvidas", href: "#faq" },
];
---

<header class="sticky top-0 z-40 border-b border-roxo/10 bg-white/95 backdrop-blur">
  <div
    class="mx-auto flex w-full max-w-[1200px] items-center justify-between gap-6 px-[22px] py-3 sm:px-8 lg:px-12"
  >
    <a href="#topo" aria-label="Clube do Fluente — início">
      <Logo />
    </a>

    <!-- Navegação desktop -->
    <nav aria-label="Principal" class="hidden lg:block">
      <ul class="flex items-center gap-7">
        {
          navegacao.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-apoio font-medium text-roxo/80 transition-colors hover:text-roxo"
              >
                {item.rotulo}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>


    <!-- Botão hambúrguer (mobile) -->
    <button
      type="button"
      id="botao-menu"
      class="flex h-10 w-10 shrink-0 items-center justify-center rounded-[0.75rem] bg-roxo lg:hidden"
      aria-label="Abrir menu"
      aria-expanded="false"
      aria-controls="menu-mobile"
    >
      <span class="flex flex-col gap-[0.3125rem]" aria-hidden="true">
        <span class="block h-[2.5px] w-5 rounded-full bg-white"></span>
        <span class="block h-[2.5px] w-5 rounded-full bg-white"></span>
        <span class="block h-[2.5px] w-5 rounded-full bg-white"></span>
      </span>
    </button>
  </div>

  <!-- Painel mobile -->
  <div id="menu-mobile" hidden class="border-t border-roxo/10 bg-white lg:hidden">
    <nav aria-label="Principal (mobile)" class="px-[22px] py-4">
      <ul class="flex flex-col">
        {
          navegacao.map((item) => (
            <li>
              <a
                href={item.href}
                class="block border-b border-roxo/10 py-3 text-corpo font-medium text-roxo"
              >
                {item.rotulo}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const botao = document.getElementById("botao-menu");
  const painel = document.getElementById("menu-mobile");

  if (botao && painel) {
    const alternar = (abrir: boolean) => {
      painel.hidden = !abrir;
      botao.setAttribute("aria-expanded", String(abrir));
      botao.setAttribute("aria-label", abrir ? "Fechar menu" : "Abrir menu");
    };

    botao.addEventListener("click", () => {
      alternar(painel.hidden);
    });

    // Fecha ao navegar por uma âncora
    painel.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => alternar(false));
    });

    // Fecha com Esc
    document.addEventListener("keydown", (evento) => {
      if (evento.key === "Escape" && !painel.hidden) {
        alternar(false);
        botao.focus();
      }
    });
  }
</script>
