---
/**
 * Título de seção no padrão do design: display serif, com a parte final
 * em itálico (opcionalmente sublinhada à mão), seguido de um texto de apoio
 * opcional (slot "apoio").
 */
interface Props {
  /** Trecho em peso normal. */
  inicio: string;
  /** Trecho enfatizado em itálico (padrão visual do Clube). */
  enfase?: string;
  /** Classe de cor do trecho inicial (padrão: herda da seção). */
  classeInicio?: string;
  /** Classe de cor do trecho em itálico (padrão: herda da seção). */
  classeEnfase?: string;
  /**
   * Sublinhado à mão sob o trecho em itálico. Usado só em algumas seções,
   * para o traço continuar sendo destaque. "escuro" é a cor para fundo roxo.
   */
  sublinhado?: "claro" | "escuro";
  /** Alinha ao centro (usado em seções de fundo cheio). */
  centro?: boolean;
  class?: string;
}
const {
  inicio,
  enfase,
  classeInicio = "",
  classeEnfase = "",
  sublinhado,
  centro = false,
  class: classe = "",
} = Astro.props;
const alinhamento = centro ? "text-center mx-auto" : "";
const classeSublinhado = {
  claro: "sublinhado-mao",
  escuro: "sublinhado-mao-escuro",
};
/**
 * Ênfase curta não quebra: sem isso o `text-wrap: balance` pode deixar uma
 * palavra solta no fim da linha de cima ("Dois idiomas, o / mesmo cuidado").
 * 20 caracteres ainda cabem numa linha no mobile; ênfases maiores quebram
 * normalmente.
 */
const MAX_ENFASE_SEM_QUEBRA = 20;
const semQuebra = enfase && enfase.length <= MAX_ENFASE_SEM_QUEBRA ? "whitespace-nowrap" : "";
/** Nas longas, a primeira palavra fica presa à segunda pelo mesmo motivo ("O / que faz..."). */
const textoEnfase = enfase?.replace(" ", " ");
---

<div class={`${alinhamento} ${classe}`}>
  <h2 class="max-w-[20ch] text-titulo font-semibold" class:list={[centro && "mx-auto"]}>
    <span class={classeInicio}>{inicio}</span>{enfase && <> <em class:list={["italic", sublinhado && classeSublinhado[sublinhado], semQuebra, classeEnfase]}>{textoEnfase}</em></>}
  </h2>
  {
    Astro.slots.has("apoio") && (
      <p class="mt-4 max-w-[52ch] text-corpo opacity-90" class:list={[centro && "mx-auto"]}>
        <slot name="apoio" />
      </p>
    )
  }
</div>
