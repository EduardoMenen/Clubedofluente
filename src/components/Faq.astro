---
import Secao from "./Secao.astro";
import TituloSecao from "./TituloSecao.astro";

/** Perguntas e respostas validadas com o Clube. */
const perguntas = [
  {
    pergunta: "Como funcionam as aulas?",
    resposta:
      "As aulas são online, ao vivo e por videochamada, com dia e horário combinados com a professora. Há opções de aula individual, dupla, trio e turma.",
    aberta: false,
  },
  {
    pergunta: "Posso remarcar uma aula?",
    resposta:
      "Sim. Basta avisar com no mínimo 3 horas de antecedência. A reposição é combinada com a professora, de acordo com a disponibilidade de ambos.",
    aberta: false,
  },
  {
    pergunta: "Em quais horários posso ter minha aula?",
    resposta: "De segunda a sexta, das 8h às 21h, e aos sábados, das 8h às 15h.",
    aberta: false,
  },
  {
    pergunta: "Recebo certificado?",
    resposta: "Sim. Ao atingir o nível avançado no idioma, o aluno recebe certificado.",
    aberta: false,
  },
  {
    pergunta: "O material está incluso no valor?",
    resposta:
      "Sim. O material é preparado pela professora de acordo com o perfil e objetivos do aluno e não possui custo adicional.",
    aberta: false,
  },
  {
    pergunta: "Tem contrato de fidelidade?",
    resposta: "Não. Os planos são mensais, sem taxa de matrícula e sem contrato de fidelidade.",
    aberta: false,
  },
  {
    pergunta: "Quais são as formas de pagamento?",
    resposta: "Pix, boleto e cartão de crédito.",
    aberta: false,
  },
];
---

<Secao id="faq" fundo="lavanda">
  <TituloSecao inicio="Perguntas que" enfase="todo mundo faz" />

  <div class="mt-8 flex flex-col gap-[11px] lg:mt-12 lg:max-w-[820px]">
    {
      perguntas.map((item) => (
        <details class="group rounded-card bg-white px-4 py-4 shadow-card lg:px-6" open={item.aberta}>
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 [&::-webkit-details-marker]:hidden">
            <h3 class="font-sans text-corpo font-semibold text-roxo">{item.pergunta}</h3>
            <span
              class="relative block h-[13px] w-[13px] shrink-0 text-roxo"
              aria-hidden="true"
            >
              <span class="absolute top-1/2 left-0 h-[2px] w-full -translate-y-1/2 rounded-full bg-current" />
              <span class="absolute top-0 left-1/2 h-full w-[2px] -translate-x-1/2 rounded-full bg-current transition-transform duration-200 group-open:scale-y-0" />
            </span>
          </summary>
          <p class="mt-3 max-w-[68ch] text-apoio text-cinza">{item.resposta}</p>
        </details>
      ))
    }
  </div>
</Secao>
