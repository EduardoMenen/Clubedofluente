---
interface Props {
  variante?: "primario" | "secundario" | "claro" | "escuro" | "areia";
  href?: string;
  type?: "button" | "submit";
  externo?: boolean;
  class?: string;
}

const {
  variante = "primario",
  href,
  type = "button",
  externo = true,
  class: classe = "",
} = Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 rounded-pill px-6 text-center font-semibold " +
  "min-h-[3.25rem] text-[1.0625rem] leading-tight transition-colors duration-150 cursor-pointer";

const variantes = {
  // vidro roxo — CTA principal
  primario: "btn-vidro-roxo",
  // vidro claro — CTA de apoio (cor do texto herdada da seção)
  secundario: "btn-vidro",
  claro: "btn-vidro",
  // dentro de card-vidro-escuro / sobre fundo roxo
  escuro: "btn-vidro-escuro",
  // CTA principal sobre banner roxo
  areia: "btn-areia",
};

const classes = `${base} ${variantes[variante]} ${classe}`;
const attrsExternos = externo ? { target: "_blank", rel: "noopener noreferrer" } : {};
---

{
  href ? (
    <a href={href} class={classes} {...attrsExternos}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes}>
      <slot />
    </button>
  )
}
