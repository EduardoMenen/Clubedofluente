---
/**
 * Bandeiras em SVG inline (sem requisicao de rede).
 * Aproximacao do asset "Flag/USA/40px" e "Flag/Spain/40px" do Figma —
 * quando o asset original estiver disponivel, trocar aqui.
 */
interface Props {
  pais: "usa" | "espanha";
  class?: string;
}
const { pais, class: classe = "" } = Astro.props;
const rotulos = { usa: "Bandeira dos Estados Unidos", espanha: "Bandeira da Espanha" };
---

<svg
  viewBox="0 0 40 40"
  class={`h-10 w-10 shrink-0 ${classe}`}
  role="img"
  aria-label={rotulos[pais]}
>
  <defs>
    <clipPath id={`recorte-${pais}`}>
      <circle cx="20" cy="20" r="20" />
    </clipPath>
  </defs>
  <g clip-path={`url(#recorte-${pais})`}>
    {
      pais === "usa" ? (
        <>
          <rect width="40" height="40" fill="#fff" />
          {[0, 2, 4, 6, 8, 10, 12].map((i) => (
            <rect y={i * 3.08} width="40" height="3.08" fill="#B22234" />
          ))}
          <rect width="18" height="21.5" fill="#3C3B6E" />
          {[3, 8, 13].map((y) =>
            [3, 8, 13].map((x) => <circle cx={x + 1} cy={y + 1.5} r="1.1" fill="#fff" />)
          )}
        </>
      ) : (
        <>
          <rect width="40" height="40" fill="#AA151B" />
          <rect y="10" width="40" height="20" fill="#F1BF00" />
        </>
      )
    }
  </g>
  <circle cx="20" cy="20" r="19.25" fill="none" stroke="currentColor" stroke-opacity="0.15" stroke-width="1.5" />
</svg>
