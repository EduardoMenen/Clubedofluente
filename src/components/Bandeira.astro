---
/**
 * Bandeiras em SVG inline (sem requisicao de rede).
 * Aproximacao do asset "Flag/USA/40px" e "Flag/Spain/40px" do Figma —
 * quando o asset original estiver disponivel, trocar aqui. A da França não
 * tem asset no Figma (entrou para a tag da professora de francês).
 */
interface Props {
  pais: "usa" | "espanha" | "franca";
  /** "sm" = 16px, "md" = 40px (padrão), "lg" = 56px. */
  tamanho?: "sm" | "md" | "lg";
  class?: string;
}
const { pais, tamanho = "md", class: classe = "" } = Astro.props;
const tamanhos = { sm: "h-4 w-4", md: "h-10 w-10", lg: "h-14 w-14" };
const rotulos = {
  usa: "Bandeira dos Estados Unidos",
  espanha: "Bandeira da Espanha",
  franca: "Bandeira da França",
};
// ID único por instância: se a mesma bandeira aparecer duas vezes na página,
// um clipPath com ID repetido é HTML inválido (e quebra se o primeiro sumir).
const idRecorte = `recorte-${pais}-${Math.random().toString(36).slice(2, 8)}`;
---

<svg
  viewBox="0 0 40 40"
  class={`${tamanhos[tamanho]} shrink-0 ${classe}`}
  role="img"
  aria-label={rotulos[pais]}
>
  <defs>
    <clipPath id={idRecorte}>
      <circle cx="20" cy="20" r="20" />
    </clipPath>
  </defs>
  <g clip-path={`url(#${idRecorte})`}>
    {
      pais === "usa" ? (
        <>
          <rect width="40" height="40" fill="#fff" />
          {[0, 2, 4, 6, 8, 10, 12].map((i) => (
            <rect y={i * 3.08} width="40" height="3.08" fill="#B22234" />
          ))}
          <rect width="18" height="21.5" fill="#3C3B6E" />
          {[3, 8, 13].map((y) =>
            [3, 8, 13].map((x) => <circle cx={x + 1} cy={y + 1.5} r="1.1" fill="#fff" />)
          )}
        </>
      ) : pais === "espanha" ? (
        <>
          <rect width="40" height="40" fill="#AA151B" />
          <rect y="10" width="40" height="20" fill="#F1BF00" />
        </>
      ) : (
        <>
          <rect width="13.34" height="40" fill="#0055A4" />
          <rect x="13.33" width="13.34" height="40" fill="#fff" />
          <rect x="26.66" width="13.34" height="40" fill="#EF4135" />
        </>
      )
    }
  </g>
  <circle cx="20" cy="20" r="19.25" fill="none" stroke="currentColor" stroke-opacity="0.15" stroke-width="1.5" />
</svg>
