---
import Secao from "./Secao.astro";
import TituloSecao from "./TituloSecao.astro";
import Botao from "./Botao.astro";
import Bandeira from "./Bandeira.astro";
import { LINKS } from "../config";

/** Traços de 24×24 (mesma grade dos ícones de Como funciona). */
const pontos = [
  {
    texto: "Conversação em todas as aulas",
    icone: [
      "M14 9a2 2 0 0 1-2 2H6l-4 4V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2z",
      "M18 9h2a2 2 0 0 1 2 2v11l-4-4h-6a2 2 0 0 1-2-2v-1",
    ],
  },
  {
    texto: "Fala, escuta, leitura e escrita",
    icone: [
      "M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3",
    ],
  },
  {
    texto: "Pronúncia e vocabulário para situações reais",
    icone: [
      "M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z",
      "M19 10v2a7 7 0 0 1-14 0v-2",
      "M12 19v3",
    ],
  },
  {
    texto: "Preparação para viagens, reuniões e entrevistas",
    icone: [
      "M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z",
    ],
  },
  {
    texto: "Contato com diferentes sotaques e formas de falar",
    icone: [
      "M22 12a10 10 0 1 1-20 0 10 10 0 0 1 20 0",
      "M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20",
      "M2 12h20",
    ],
  },
  {
    texto: "Gramática aplicada ao uso do idioma",
    icone: [
      "M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z",
      "M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z",
    ],
  },
];
---

<Secao id="idiomas" fundo="creme">
  <TituloSecao inicio="Dois idiomas," enfase="o mesmo cuidado">
    <Fragment slot="apoio">
      Inglês e espanhol têm o mesmo método, a mesma estrutura e as mesmas professoras dedicadas.
    </Fragment>
  </TituloSecao>

  <article
    class="card-vidro relative isolate mt-9 flex flex-col gap-6 overflow-hidden p-[18px] lg:mt-12 lg:gap-8 lg:p-10"
  >
    {/*
      Marca d'água: `-z-10` dentro do `isolate` fica acima do fundo de vidro e
      abaixo de todo o conteúdo, sem precisar de `relative` em cada filho.
      No mobile não há espaço livre ao lado do texto: ela desce para logo
      abaixo do título, passando por trás das bandeiras, e o primeiro parágrafo
      se afasta (mt-14) para abrir essa faixa. A partir de sm volta para o
      canto direito.
    */}
    <span
      class="pointer-events-none absolute top-[3.6rem] left-3 -z-10 font-display text-[3.4rem] leading-none font-semibold whitespace-nowrap italic text-roxo-claro/20 select-none sm:top-1 sm:left-auto sm:-right-4 sm:text-[5.5rem] lg:top-2 lg:text-[8.5rem]"
      aria-hidden="true"
    >
      Hello · Hola
    </span>

    <div>
      <div class="flex items-center gap-4">
        {/* Bandeiras sobrepostas; o anel branco separa uma da outra. */}
        <div class="flex shrink-0">
          <Bandeira
            pais="usa"
            tamanho="lg"
            class="rounded-full text-roxo shadow-[0_6px_16px_-6px_rgb(82_25_138/0.4)] ring-[3px] ring-white"
          />
          <Bandeira
            pais="espanha"
            tamanho="lg"
            class="-ml-4 rounded-full text-roxo shadow-[0_6px_16px_-6px_rgb(82_25_138/0.4)] ring-[3px] ring-white"
          />
        </div>
        <div>
          <h3 class="text-subtitulo font-semibold leading-none text-roxo">Inglês e espanhol</h3>
          <p class="mt-1 text-apoio text-roxo/70">Do zero à fluência</p>
        </div>
      </div>

      <p class="mt-14 max-w-[52ch] text-apoio font-medium text-roxo sm:mt-6">
        Tudo o que você precisa para se comunicar de verdade, muito além da gramática.
      </p>

      <p class="mt-3 max-w-[52ch] text-apoio text-roxo/85">
        As aulas trabalham o idioma de forma completa, para que você não apenas entenda, mas consiga
        usá-lo com segurança em diferentes situações.
      </p>
    </div>

    <ul
      class="grid gap-3 pt-2 sm:grid-cols-2 lg:grid-cols-3 lg:gap-x-8 lg:gap-y-4"
    >
      {
        pontos.map((ponto) => (
          <li class="flex items-center gap-3 text-apoio text-roxo/85">
            <span
              class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-lavanda text-roxo"
              aria-hidden="true"
            >
              <svg
                viewBox="0 0 24 24"
                class="h-5 w-5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                {ponto.icone.map((d) => <path d={d} />)}
              </svg>
            </span>
            <span>{ponto.texto}</span>
          </li>
        ))
      }
    </ul>

    <Botao href={LINKS.idiomas} class="w-full lg:w-auto lg:self-start">
      Quero aprender um novo idioma
    </Botao>
  </article>
</Secao>
