---
import Secao from "./Secao.astro";
import TituloSecao from "./TituloSecao.astro";
import Botao from "./Botao.astro";
import Bandeira from "./Bandeira.astro";
import { LINKS } from "../config";

const pontos = [
  "Conversação em todas as aulas",
  "Fala, escuta, leitura e escrita",
  "Pronúncia e vocabulário para situações reais",
  "Preparação para viagens, reuniões e entrevistas",
  "Contato com diferentes sotaques e formas de falar",
  "Gramática aplicada ao uso do idioma",
];
---

<Secao id="idiomas" fundo="creme">
  <TituloSecao inicio="Dois idiomas," enfase="o mesmo cuidado">
    <Fragment slot="apoio">
      Inglês e espanhol têm o mesmo método, a mesma estrutura e as mesmas professoras dedicadas.
    </Fragment>
  </TituloSecao>

  <article class="mt-9 flex flex-col rounded-card bg-lavanda p-[18px] lg:mt-12 lg:p-8">
    <div class="flex items-center gap-3">
      <Bandeira pais="usa" class="text-roxo" />
      <Bandeira pais="espanha" class="text-roxo" />
      <div>
        <h3 class="text-subtitulo font-semibold leading-none text-roxo">Inglês e espanhol</h3>
        <p class="mt-1 text-apoio text-roxo/70">Do zero à fluência</p>
      </div>
    </div>

    <p class="mt-6 max-w-[52ch] text-apoio font-medium text-roxo">
      Tudo o que você precisa para se comunicar de verdade, muito além da gramática.
    </p>

    <p class="mt-3 max-w-[52ch] text-apoio text-roxo/85">
      As aulas trabalham o idioma de forma completa, para que você não apenas entenda, mas consiga
      usá-lo com segurança em diferentes situações.
    </p>

    <ul class="mt-6 grid gap-2 lg:grid-cols-2 lg:gap-x-8">
      {
        pontos.map((ponto) => (
          <li class="flex items-start gap-[9px] text-apoio text-roxo/85">
            <span
              class="mt-[0.5em] block h-[7px] w-[7px] shrink-0 rounded-full bg-roxo"
              aria-hidden="true"
            />
            <span>{ponto}</span>
          </li>
        ))
      }
    </ul>

    <Botao href={LINKS.idiomas} class="mt-8 w-full lg:w-auto lg:self-start">
      Quero aprender um novo idioma
    </Botao>
  </article>
</Secao>
